{
    "openapi": "3.0.0",
    "info": {
        "title": "API Oficina Mecânica",
        "version": "2.0.0",
        "description": "API para gerenciamento de oficina mecânica — Fase 2"
    },
    "servers": [
        { "url": "http://localhost:3000", "description": "Desenvolvimento local" }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
        },
        "schemas": {
            "Client": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "name": { "type": "string", "example": "João Silva" },
                    "document": { "type": "string", "example": "12345678901" },
                    "email": { "type": "string", "example": "joao@email.com" },
                    "phone": { "type": "string", "example": "11999999999" }
                }
            },
            "UpdateClientDTO": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "example": "João Silva Atualizado" },
                    "email": { "type": "string", "example": "novo@email.com" },
                    "phone": { "type": "string", "example": "11988887777" }
                }
            },
            "Vehicle": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "plate": { "type": "string", "example": "ABC1234 ou ABC1D23 (Mercosul)" },
                    "brand": { "type": "string", "example": "Honda" },
                    "model": { "type": "string", "example": "Civic" },
                    "year": { "type": "integer", "example": 2022 }
                }
            },
            "UpdateVehicleDTO": {
                "type": "object",
                "properties": {
                    "plate": { "type": "string", "example": "ABC1D23" },
                    "brand": { "type": "string", "example": "Honda" },
                    "model": { "type": "string", "example": "Civic" },
                    "year": { "type": "integer", "example": 2023 }
                }
            },
            "Part": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string", "example": "Pastilha de Freio" },
                    "description": { "type": "string" },
                    "price": { "type": "number", "example": 89.90 },
                    "stock": { "type": "integer", "example": 10 },
                    "minimumStock": { "type": "integer", "example": 3 }
                }
            },
            "CreatePartDTO": {
                "type": "object",
                "required": ["name", "price"],
                "properties": {
                    "name": { "type": "string", "example": "Pastilha de Freio" },
                    "description": { "type": "string" },
                    "price": { "type": "number", "example": 89.90 },
                    "stock": { "type": "integer", "example": 10 },
                    "minimumStock": { "type": "integer", "example": 3 }
                }
            },
            "Service": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string", "example": "Troca de Pastilha de Freio" },
                    "description": { "type": "string" },
                    "price": { "type": "number", "example": 120.00 },
                    "active": { "type": "boolean", "example": true }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string", "example": "João Mecânico" },
                    "email": { "type": "string", "example": "mecanico@email.com" },
                    "role": { "type": "string", "example": "mecanico" }
                }
            },
            "ServiceOrder": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "status": {
                        "type": "string",
                        "enum": ["RECEBIDA", "EM_DIAGNOSTICO", "AGUARDANDO_APROVACAO", "EM_EXECUCAO", "FINALIZADA", "ENTREGUE", "CANCELADA"]
                    },
                    "budget": { "type": "number", "example": 209.90 },
                    "observation": { "type": "string" }
                }
            },
            "StatusResponse": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "status": { "type": "string", "enum": ["RECEBIDA", "EM_DIAGNOSTICO", "AGUARDANDO_APROVACAO", "EM_EXECUCAO", "FINALIZADA", "ENTREGUE", "CANCELADA"] },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": { "error": { "type": "string" } }
            },
            "StockMovement": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "partId": { "type": "integer" },
                    "quantity": { "type": "integer" },
                    "type": { "type": "string", "enum": ["IN", "OUT"] },
                    "description": { "type": "string" }
                }
            },
            "AddDiagnosticDTO": {
                "type": "object",
                "required": ["title", "description"],
                "properties": {
                    "title": { "type": "string", "example": "Diagnóstico Freios" },
                    "description": { "type": "string" },
                    "includeInBudget": { "type": "boolean", "example": true },
                    "priority": { "type": "string", "enum": ["baixa", "media", "alta"] },
                    "mechanicNote": { "type": "string" },
                    "serviceIds": { "type": "array", "items": { "type": "integer" } },
                    "partIds": { "type": "array", "items": { "type": "integer" } }
                }
            }
        }
    },
    "paths": {
        "/user": {
            "post": {
                "summary": "Criar usuário",
                "tags": ["Usuários"],
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": {
                                "type": "object",
                                "required": ["name", "email", "password", "role"],
                                "properties": {
                                    "name": { "type": "string" },
                                    "email": { "type": "string" },
                                    "password": { "type": "string" },
                                    "role": { "type": "string", "enum": ["admin", "mecanico", "atendente"] }
                                }
                            } } }
                },
                "responses": { "201": { "description": "Usuário criado" }, "400": { "description": "Erro" } }
            }
        },
        "/user/login": {
            "post": {
                "summary": "Login",
                "tags": ["Usuários"],
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": {
                                "type": "object",
                                "required": ["email", "password"],
                                "properties": {
                                    "email": { "type": "string", "example": "mecanico@email.com" },
                                    "password": { "type": "string", "example": "123456" }
                                }
                            } } }
                },
                "responses": { "200": { "description": "Token JWT retornado" }, "401": { "description": "Credenciais inválidas" } }
            }
        },
        "/user/logout": {
            "post": {
                "summary": "Logout",
                "tags": ["Usuários"],
                "security": [{ "bearerAuth": [] }],
                "responses": { "200": { "description": "Logout realizado" } }
            }
        },
        "/clients": {
            "post": {
                "summary": "Criar cliente",
                "tags": ["Clientes"],
                "security": [{ "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": {
                                "type": "object",
                                "required": ["name", "document", "email", "phone"],
                                "properties": {
                                    "name": { "type": "string" },
                                    "document": { "type": "string", "description": "CPF ou CNPJ" },
                                    "email": { "type": "string" },
                                    "phone": { "type": "string" }
                                }
                            } } }
                },
                "responses": { "201": { "description": "Cliente criado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } } } }
            },
            "get": {
                "summary": "Listar clientes",
                "tags": ["Clientes"],
                "security": [{ "bearerAuth": [] }],
                "responses": { "200": { "description": "Lista de clientes" } }
            }
        },
        "/clients/{id}": {
            "get": {
                "summary": "Buscar cliente por ID",
                "tags": ["Clientes"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Cliente encontrado" }, "404": { "description": "Não encontrado" } }
            },
            "put": {
                "summary": "Atualizar cliente",
                "tags": ["Clientes"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": {
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateClientDTO" } } }
                },
                "responses": {
                    "200": { "description": "Cliente atualizado", "content": { "application/json": { "schema": {
                                    "type": "object",
                                    "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Client" } }
                                } } } },
                    "400": { "description": "Erro" },
                    "404": { "description": "Não encontrado" }
                }
            },
            "delete": {
                "summary": "Remover cliente (soft delete)",
                "tags": ["Clientes"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": {
                    "200": { "description": "Cliente removido", "content": { "application/json": { "schema": {
                                    "type": "object",
                                    "properties": { "message": { "type": "string", "example": "Cliente removido com sucesso" } }
                                } } } },
                    "400": { "description": "Erro" }
                }
            }
        },
        "/clients/document/{document}": {
            "get": {
                "summary": "Buscar cliente por CPF/CNPJ",
                "tags": ["Clientes"],
                "parameters": [{ "in": "path", "name": "document", "required": true, "schema": { "type": "string" } }],
                "responses": { "200": { "description": "Cliente encontrado" }, "404": { "description": "Não encontrado" } }
            }
        },
        "/vehicles": {
            "post": {
                "summary": "Criar veículo",
                "tags": ["Veículos"],
                "security": [{ "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": {
                                "type": "object",
                                "required": ["plate", "brand", "model", "year", "clientDocument"],
                                "properties": {
                                    "plate": { "type": "string", "example": "ABC1234 ou ABC1D23 (Mercosul)" },
                                    "brand": { "type": "string" },
                                    "model": { "type": "string" },
                                    "year": { "type": "integer" },
                                    "clientDocument": { "type": "string" }
                                }
                            } } }
                },
                "responses": { "201": { "description": "Veículo criado" } }
            },
            "get": {
                "summary": "Listar veículos",
                "tags": ["Veículos"],
                "security": [{ "bearerAuth": [] }],
                "responses": { "200": { "description": "Lista de veículos" } }
            }
        },
        "/vehicles/{id}": {
            "get": {
                "summary": "Buscar veículo por ID",
                "tags": ["Veículos"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Veículo encontrado" }, "404": { "description": "Não encontrado" } }
            },
            "put": {
                "summary": "Atualizar veículo",
                "tags": ["Veículos"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": {
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateVehicleDTO" } } }
                },
                "responses": {
                    "200": { "description": "Veículo atualizado", "content": { "application/json": { "schema": {
                                    "type": "object",
                                    "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Vehicle" } }
                                } } } },
                    "400": { "description": "Placa inválida ou já cadastrada" },
                    "404": { "description": "Não encontrado" }
                }
            },
            "delete": {
                "summary": "Remover veículo (soft delete)",
                "tags": ["Veículos"],
                "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": {
                    "200": { "description": "Veículo removido", "content": { "application/json": { "schema": {
                                    "type": "object",
                                    "properties": { "message": { "type": "string", "example": "Veículo removido com sucesso" } }
                                } } } },
                    "400": { "description": "Erro" }
                }
            }
        },
        "/parts": {
            "post": { "summary": "Criar peça", "tags": ["Peças"], "security": [{ "bearerAuth": [] }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePartDTO" } } } },
                "responses": { "201": { "description": "Peça criada" } }
            },
            "get": { "summary": "Listar peças", "tags": ["Peças"], "security": [{ "bearerAuth": [] }],
                "responses": { "200": { "description": "Lista de peças" } }
            }
        },
        "/parts/{id}": {
            "get": { "summary": "Buscar peça", "tags": ["Peças"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Peça encontrada" } }
            },
            "put": { "summary": "Atualizar peça", "tags": ["Peças"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePartDTO" } } } },
                "responses": { "200": { "description": "Peça atualizada" } }
            },
            "delete": { "summary": "Remover peça", "tags": ["Peças"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "204": { "description": "Peça removida" } }
            }
        },
        "/services": {
            "post": { "summary": "Criar serviço", "tags": ["Serviços"], "security": [{ "bearerAuth": [] }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": {
                                "type": "object", "required": ["name", "price"],
                                "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "price": { "type": "number" }, "active": { "type": "boolean" } }
                            } } } },
                "responses": { "201": { "description": "Serviço criado" } }
            },
            "get": { "summary": "Listar serviços", "tags": ["Serviços"], "security": [{ "bearerAuth": [] }],
                "responses": { "200": { "description": "Lista de serviços" } }
            }
        },
        "/services/{id}": {
            "get": { "summary": "Buscar serviço", "tags": ["Serviços"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Serviço encontrado" } }
            },
            "put": { "summary": "Atualizar serviço", "tags": ["Serviços"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": { "content": { "application/json": { "schema": {
                                "type": "object",
                                "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "price": { "type": "number" }, "active": { "type": "boolean" } }
                            } } } },
                "responses": { "200": { "description": "Serviço atualizado" } }
            },
            "delete": { "summary": "Remover serviço", "tags": ["Serviços"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "204": { "description": "Serviço removido" } }
            }
        },
        "/service-order": {
            "post": { "summary": "Abrir OS", "tags": ["Ordens de Serviço"], "security": [{ "bearerAuth": [] }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": {
                                "type": "object", "required": ["client", "vehicle"],
                                "properties": {
                                    "client": { "type": "object", "properties": {
                                            "document": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string" }, "phone": { "type": "string" }
                                        } },
                                    "vehicle": { "type": "object", "properties": {
                                            "id": { "type": "integer" }, "plate": { "type": "string", "description": "Formato antigo ABC1234 ou Mercosul ABC1D23" },
                                            "brand": { "type": "string" }, "model": { "type": "string" }, "year": { "type": "integer" }
                                        } },
                                    "observation": { "type": "string" }
                                }
                            } } } },
                "responses": { "201": { "description": "OS criada, retorna ID único" } }
            },
            "get": { "summary": "Listar OS (ordenadas por status, sem finalizadas/entregues)", "tags": ["Ordens de Serviço"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "query", "name": "excludeFinished", "schema": { "type": "boolean", "default": true }, "description": "false para incluir FINALIZADA e ENTREGUE" }],
                "responses": { "200": { "description": "Lista ordenada: EM_EXECUCAO > AGUARDANDO_APROVACAO > EM_DIAGNOSTICO > RECEBIDA" } }
            }
        },
        "/service-order/{id}": {
            "get": { "summary": "Buscar OS por ID (público)", "tags": ["Ordens de Serviço"],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "OS encontrada" }, "404": { "description": "Não encontrada" } }
            }
        },
        "/service-order/{id}/status": {
            "get": { "summary": "Consultar status da OS (público — para o cliente)", "tags": ["Ordens de Serviço"],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Status atual", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusResponse" } } } }, "404": { "description": "Não encontrada" } }
            }
        },
        "/service-order/{id}/accept": {
            "post": { "summary": "Aceitar OS (mecânico) — RECEBIDA → EM_DIAGNOSTICO", "tags": ["Ordens de Serviço"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": {
                                "type": "object", "properties": { "mechanicId": { "type": "integer" } }
                            } } } },
                "responses": { "200": { "description": "OS aceita, status → EM_DIAGNOSTICO" } }
            }
        },
        "/service-order/{id}/diagnostic": {
            "post": { "summary": "Adicionar diagnóstico", "tags": ["Diagnósticos"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddDiagnosticDTO" } } } },
                "responses": { "201": { "description": "Diagnóstico adicionado" } }
            }
        },
        "/service-order/{id}/finish-diagnostic": {
            "post": { "summary": "Finalizar diagnóstico — EM_DIAGNOSTICO → AGUARDANDO_APROVACAO (envia email)", "tags": ["Diagnósticos"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Orçamento gerado, email enviado ao cliente com link de aprovação" } }
            }
        },
        "/service-order/{id}/approve": {
            "post": { "summary": "Aprovar orçamento (público — link enviado por email) — AGUARDANDO_APROVACAO → EM_EXECUCAO", "tags": ["Ordens de Serviço"],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "requestBody": { "content": { "application/json": { "schema": {
                                "type": "object",
                                "properties": { "approvedDiagnosticIds": { "type": "array", "items": { "type": "integer" } } }
                            } } } },
                "responses": { "200": { "description": "Orçamento aprovado, estoque baixado, status → EM_EXECUCAO" }, "400": { "description": "Estoque insuficiente" } }
            }
        },
        "/service-order/{id}/reject": {
            "post": { "summary": "Recusar orçamento (público — link enviado por email) — AGUARDANDO_APROVACAO → CANCELADA", "tags": ["Ordens de Serviço"],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Orçamento recusado, status → CANCELADA" } }
            }
        },
        "/service-order/{id}/finish": {
            "post": { "summary": "Finalizar execução — EM_EXECUCAO → FINALIZADA", "tags": ["Ordens de Serviço"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "OS finalizada" } }
            }
        },
        "/service-order/{id}/deliver": {
            "post": { "summary": "Entregar veículo — FINALIZADA → ENTREGUE", "tags": ["Ordens de Serviço"], "security": [{ "bearerAuth": [] }],
                "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "Veículo entregue" } }
            }
        },
        "/service-executions/start": {
            "post": { "summary": "Iniciar execução de serviço", "tags": ["Execução de Serviços"], "security": [{ "bearerAuth": [] }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": {
                                "type": "object", "required": ["serviceOrderId", "serviceId"],
                                "properties": { "serviceOrderId": { "type": "integer" }, "serviceId": { "type": "integer" }, "mechanicNote": { "type": "string" } }
                            } } } },
                "responses": { "200": { "description": "Serviço iniciado" } }
            }
        },
        "/service-executions/finish": {
            "post": { "summary": "Finalizar execução de serviço", "tags": ["Execução de Serviços"], "security": [{ "bearerAuth": [] }],
                "requestBody": { "required": true, "content": { "application/json": { "schema": {
                                "type": "object", "required": ["serviceOrderId", "serviceId"],
                                "properties": { "serviceOrderId": { "type": "integer" }, "serviceId": { "type": "integer" }, "mechanicNote": { "type": "string" } }
                            } } } },
                "responses": { "200": { "description": "Serviço finalizado" } }
            }
        },
        "/service-executions/average/{serviceId}": {
            "get": { "summary": "Tempo médio de um serviço", "tags": ["Estatísticas"], "security": [{ "bearerAuth": [] }],
