    "/stock/movements": {
      "get": {
        "summary": "Listar movimentações de estoque",
        "tags": ["Estoque"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "partId",
            "schema": { "type": "integer" },
            "description": "Filtrar por ID da peça"
          },
          {
            "in": "query",
            "name": "serviceOrderId",
            "schema": { "type": "integer" },
            "description": "Filtrar por ID da OS"
          },
          {
            "in": "query",
            "name": "startDate",
            "schema": { "type": "string", "format": "date" },
            "description": "Data inicial (YYYY-MM-DD)"
          },
          {
            "in": "query",
            "name": "endDate",
            "schema": { "type": "string", "format": "date" },
            "description": "Data final (YYYY-MM-DD)"
          },
          {
            "in": "query",
            "name": "type",
            "schema": { "type": "string", "enum": ["IN", "OUT"] },
            "description": "Tipo de movimentação (IN=entrada, OUT=saída)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de movimentações",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/StockMovement" }
                    },
                    "count": { "type": "integer", "example": 5 }
                  }
                }
              }
            }
          }
        }
      }
    },
