{
  "name": "oficina-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r newrelic dist/index.js",
    "dev": "ts-node-dev -r newrelic --respawn src/index.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "dotenv -e .env -- npm run typeorm -- migration:run -d src/infrastructure/database/data-source.ts",
    "migration:generate": "dotenv -e .env -- npm run typeorm -- migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:revert": "dotenv -e .env -- npm run typeorm -- migration:revert -d src/infrastructure/database/data-source.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sonar": "sonar-scanner"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cpf-cnpj-validator": "^1.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "newrelic": "^12.25.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^1.4.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "sonarqube-scanner": "^4.3.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
